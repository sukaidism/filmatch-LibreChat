      "name": "Primary auth action",
      "kind": "button",
      "description": "Shared default button with auth sizing and soft shape.",
      "html": "<button type=\"button\" class=\"ds-primary\">Continue</button>",
      "css": ".ds-primary{font-family:var(--theme-font-family,Inter,ui-sans-serif,system-ui,sans-serif);font-size:.875rem;line-height:1.428571;font-weight:500;cursor:pointer;transition:background-color var(--theme-motion-fast,120ms),color var(--theme-motion-fast,120ms);height:var(--theme-auth-button-height,3rem);padding:0 var(--theme-button-padding-x,1rem);border:0;border-radius:var(--theme-auth-control-radius,.75rem);background:rgb(var(--button-primary,64 87 49));color:rgb(var(--text-inverted,255 253 247))}.ds-primary:hover{background:rgb(var(--button-primary-hover,48 67 36))}.ds-primary:active{background:rgb(var(--surface-inverted-pressed,48 67 36))}.ds-primary:focus-visible{outline:2px solid rgb(var(--focus-control,64 87 49));outline-offset:2px;}.ds-primary:disabled{opacity:.5;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}",
