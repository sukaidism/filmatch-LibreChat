      "css": ".ds-appearance{font-family:var(--theme-font-family,Inter,ui-sans-serif,system-ui,sans-serif);font-size:.875rem;line-height:1.428571;font-weight:500;cursor:pointer;transition:background-color var(--theme-motion-fast,120ms),color var(--theme-motion-fast,120ms);display:inline-flex;align-items:center;justify-content:center;padding:.5rem;border:0;border-radius:var(--theme-radius-lg,.5rem);background:transparent;color:rgb(var(--text-primary,35 43 33))}.ds-appearance:hover{background:rgb(var(--surface-hover,226 231 213))}.ds-appearance:active{background:rgb(var(--surface-pressed,226 231 213))}.ds-appearance:focus-visible{outline:2px solid rgb(var(--focus-control,64 87 49));outline-offset:2px;}@media(prefers-reduced-motion:reduce){.ds-appearance{transition:none}}"
