      "html": "<div class=\"ds-field\"><input class=\"ds-auth-input\" id=\"ds-email\" type=\"email\" placeholder=\" \"><label class=\"ds-label\" for=\"ds-email\">Email address</label></div>",
      "css": ".ds-field{position:relative;width:100%;max-width:322px;font-family:var(--theme-font-family,Inter,ui-sans-serif,system-ui,sans-serif);font-size:.875rem;line-height:1.428571;}.ds-auth-input{font-family:var(--theme-font-family,Inter,ui-sans-serif,system-ui,sans-serif);font-size:.875rem;line-height:1.428571;height:var(--theme-auth-field-height,3rem);width:100%;box-sizing:border-box;padding:.125rem .875rem 0;border:1px solid rgb(var(--border-control,202 207 187));border-radius:var(--theme-auth-control-radius,.75rem);background:transparent;color:rgb(var(--text-primary,35 43 33))}.ds-label{position:absolute;left:.75rem;top:.375rem;padding:0 .5rem;transform:translateY(-1rem) scale(.75);transform-origin:0;background:rgb(var(--surface-primary,249 246 237));color:rgb(var(--text-secondary-alt,94 103 83));transition:transform 200ms,top 200ms}.ds-auth-input:placeholder-shown:not(:focus)+.ds-label{top:50%;transform:translateY(-50%) scale(1)}.ds-auth-input:focus{border-color:rgb(var(--accent-primary,64 87 49))}.ds-auth-input:focus-visible{outline:2px solid rgb(var(--focus-control,64 87 49));outline-offset:2px;}.ds-auth-input:focus+.ds-label{color:rgb(var(--accent-primary,64 87 49))}.ds-auth-input:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-label{transition:none}}",
